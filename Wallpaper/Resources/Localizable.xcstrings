          }
        }
      }
    },
    "Each display shows its own part of the same video, as if the screens were windows onto one picture. The video is still decoded only once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each display shows its own part of the same video, as if the screens were windows onto one picture. The video is still decoded only once."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada monitor mostra a sua parte do mesmo vídeo, como se as telas fossem janelas para uma só imagem. O vídeo continua sendo decodificado uma única vez."
          }
        }
      }
    },
    "Each wallpaper is shown from its time until the next one begins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each wallpaper is shown from its time until the next one begins."
